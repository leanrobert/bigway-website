---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import aboutBg from '../assets/about-bg.png';
import { office } from '../data/site';
---

<section id="beneficios" class="container section">
	<div class="heading" data-reveal>
		<div>
			<p class="eyebrow">Por qué Bigway</p>
			<h2 class="section-title">Tecnología de primer mundo, <span class="accent">atención cercana.</span></h2>
		</div>
		<p class="lead">
			Fibra óptica, un call center profesional y técnicos propios. Todo desde nuestras oficinas en
			Mendoza.
		</p>
	</div>

	<div class="grid">
		<article class="card feature" data-reveal>
			<div class="top">
				<span class="index">01</span>
				<span class="badge"><Icon name="rocket" size={20} /></span>
			</div>
			<div>
				<h3>Fibra óptica</h3>
				<p>Última tecnología en Internet, usada en el primer mundo.</p>
			</div>
		</article>

		<article class="feature dark on-dark" data-reveal style="--reveal-delay: 80ms">
			<div class="top">
				<span class="index">02</span>
				<span class="badge dashed"><Icon name="headphones" size={20} /></span>
			</div>
			<div>
				<h3>Call center</h3>
				<p>Profesionales de alta calidad para atenderte cuando lo necesites.</p>
			</div>
		</article>

		<article class="feature brand" data-reveal style="--reveal-delay: 160ms">
				<div class="top">
					<span class="index">03</span>
					<span class="badge"><Icon name="pin" size={20} /></span>
				</div>
				<div>
				<h3>Oficinas en Mendoza</h3>
				<p>Estamos en {office.building}, {office.street}.</p>
				<a href={office.mapsUrl} class="link-underline" target="_blank" rel="noopener">
					Cómo llegar <Icon name="arrow-up-right" size={12} />
				</a>
				</div>
		</article>

		<article class="feature card" data-reveal style="--reveal-delay: 240ms">
			<div class="top">
				<span class="index">04</span>
				<span class="badge"><Icon name="phone" size={20} /></span>
			</div>
			<div>
				<h3>Servicio técnico</h3>
				<p>Profesionales capacitados para resolver cualquier inconveniente.</p>
			</div>
		</article>
	</div>
</section>

<style>
	.heading {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		align-items: end;
		gap: 1.5rem;
	}

	.heading > div {
		grid-column: span 7;
	}

	.heading h2 {
		margin-top: 1rem;
	}

	.heading .lead {
		grid-column: 9 / span 4;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.75rem;
		margin-top: 3rem;
	}

	.feature {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 1.25rem 1.5rem;
		border-radius: var(--radius-card);
	}

	.feature h3 {
		font-size: 1.5rem;
	}

	.feature p {
		margin-top: 0.5rem;
		font-size: 0.875rem;
		line-height: 1.65;
		color: color-mix(in srgb, var(--ink) 65%, transparent);
	}

	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.index {
		font-size: 0.75rem;
		color: var(--muted);
	}

	.badge {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--purple);
	}

	.dark {
		background: var(--deep);
		color: var(--cream);
	}

	.dark p,
	.dark .index {
		color: var(--mist);
	}

	.dashed {
		border: 1px dashed color-mix(in srgb, var(--mist) 50%, transparent);
		color: var(--lavender);
	}

	/* The photo fills the card behind the text, so this card is no taller than the others. */
	.photo {
		position: relative;
		justify-content: flex-end;
		overflow: hidden;
		background: var(--deep);
		color: var(--cream);
	}

	.photo img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.photo::after {
		content: '';
		position: absolute;
		inset: 0;
		/* --deep */
		background: linear-gradient(to top, rgba(48, 32, 93, 0.9), rgba(48, 32, 93, 0.4));
	}

	.photo-body {
		position: relative;
		z-index: 1;
	}

	.photo p,
	.photo .index {
		color: var(--mist);
	}

	.photo h3 {
		margin-top: 0.25rem;
	}

	.photo .link-underline {
		margin-top: 0.5rem;
	}

	.brand {
		background: var(--purple-soft);
	}

	.brand .badge {
		border-color: color-mix(in srgb, var(--purple) 25%, transparent);
	}

	@media (max-width: 1100px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 900px) {
		.heading > div,
		.heading .lead {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 600px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
