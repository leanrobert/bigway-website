---
import Icon from './Icon.astro';
import { navLinks, whatsappUrl } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer container">
	<div class="top">
		<p class="claim">Internet por fibra óptica <span class="accent">en Mendoza.</span></p>
		<nav aria-label="Pie de página">
			<ul>
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
				<li>
					<a href={whatsappUrl} target="_blank" rel="noopener">
						WhatsApp <Icon name="arrow-up-right" size={12} />
					</a>
				</li>
			</ul>
		</nav>
	</div>
	<div class="bottom">
		<p>© {year} Bigway</p>
		<p>San José, Guaymallén, Mendoza</p>
	</div>
</footer>

<style>
	.footer {
		margin-top: clamp(4rem, 8vw, 6rem);
		padding-bottom: 2rem;
	}

	.top {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: end;
		gap: 2rem 4rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--line);
	}

	.claim {
		max-width: 32rem;
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 500;
		letter-spacing: -0.035em;
		line-height: 1.1;
	}

	.top ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		font-size: 0.875rem;
	}

	.top a {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: color-mix(in srgb, var(--ink) 70%, transparent);
		text-decoration: none;
	}

	.top a:hover {
		color: var(--ink);
	}

	@media (max-width: 900px) {
		.top {
			grid-template-columns: 1fr;
			align-items: start;
		}
	}

	.bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
		padding-top: 1.5rem;
		font-size: 0.75rem;
		color: var(--muted);
	}
</style>
