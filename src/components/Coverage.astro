---
import Icon from './Icon.astro';
import coverage from '../data/coverage.json';
import { technologyLabels, type Technology } from '../data/site';

// Generated by `pnpm coverage` from the Google Earth files; the section hides until there's data.
const hasCoverage = coverage.features.length > 0;
// Legend only lists the technologies that actually have zones.
const technologies = (['fibra', 'wireless'] as Technology[]).filter((technology) =>
	coverage.features.some((feature) => feature.properties.technology === technology),
);
---

{
	hasCoverage && (
		<section id="cobertura" class="container section">
			<div class="heading" data-reveal>
				<div>
					<p class="eyebrow">Cobertura</p>
					<h2 class="section-title">
						¿Llegamos a tu casa? <span class="accent">Buscá tu dirección.</span>
					</h2>
				</div>
				<p class="lead">
					Escribí tu calle y número y te mostramos qué servicio llega a tu casa. Seguimos
					sumando barrios: si todavía no llegamos, consultanos.
				</p>
			</div>

			<div class="map-panel" data-reveal>
				{/*
					Address search: resolves to a point that's checked against the zones.
					Floats over the map like the hero's plan card; stacks above it on phones.
				*/}
				<div class="checker" data-coverage-checker>
					<form class="search" role="search" data-coverage-search>
						<label for="coverage-address" class="sr-only">
							Tu dirección
						</label>
						<input
							id="coverage-address"
							name="address"
							type="text"
							placeholder="Ej.: San Martín 1200, Godoy Cruz"
							autocomplete="street-address"
							maxlength="120"
							required
						/>
						<button type="submit" class="search-submit" aria-label="Buscar dirección">
							<Icon name="arrow" size={16} />
						</button>
					</form>

					<div class="feedback" aria-live="polite">
						<p class="note" data-coverage-note hidden />

						<div class="matches" data-coverage-matches hidden>
							<p class="matches-title">Encontramos varias. Elegí la tuya:</p>
							<ul />
						</div>

						<div class="result" data-coverage-result hidden>
							<p class="result-title">
								<span class="result-dot" aria-hidden="true" />
								<span data-result-title />
							</p>
							<p class="result-place" data-result-place />
							<a class="btn btn-dark" href="#planesfo" data-result-cta>
								<span data-result-cta-label />
								<span class="btn-arrow">
									<Icon name="arrow" size={13} />
								</span>
							</a>
						</div>
					</div>
				</div>

				<div class="map" data-coverage-map>
					<p class="status">Cargando mapa…</p>
				</div>

				<div class="legend">
					<ul>
						{technologies.map((technology) => (
							<li>
								<span class:list={['swatch', technology]} aria-hidden="true" />
								{technologyLabels[technology]}
							</li>
						))}
					</ul>
					<a href="#contactanos" class="btn btn-dark">
						¿No ves tu zona? Consultanos
						<span class="btn-arrow">
							<Icon name="arrow" size={13} />
						</span>
					</a>
				</div>
			</div>

			<p class="disclaimer" data-reveal>
				La disponibilidad esta sujeta a revisión por un asesor. Bigway no guarda la dirección
				que busques. Búsqueda de direcciones con{' '}
				<a href="https://datosgobar.github.io/georef-ar-api/" target="_blank" rel="noopener">
					Georef AR
				</a>
				.
			</p>
		</section>
	)
}

<script>
	import type { GeoJSONSource, Map as MapLibreMap, Marker } from 'maplibre-gl';
	import {
		bboxOf,
		circle,
		parseAddress,
		toMatches,
		type AddressMatch,
		type CoverageZones,
		type Position,
	} from '../lib/coverage-geo';

	const section = document.querySelector<HTMLElement>('#cobertura');
	const container = section?.querySelector<HTMLElement>('[data-coverage-map]');
	const status = container?.querySelector<HTMLElement>('.status');

	// Matching --purple and --gold in Layout.astro. Wireless is listed first so fiber draws on top.
	const COLORS = { wireless: '#c9a94a', fibra: '#6f2d91' };
	// Matching --ink: the dashed ring marking how far around the address coverage is shown.
	const RADIUS_COLOR = '#141619';
	// OpenFreeMap: free for commercial use, no API key. Attribution is added by MapLibre.
	const STYLE = 'https://tiles.openfreemap.org/styles/positron';
	// Argentina's official address API (datos.gob.ar): free, no key, CORS enabled.
	const GEOREF = 'https://apis.datos.gob.ar/georef/api/direcciones';
	// The full coverage map stays on the server; this returns only the zones around one point.
	const COVERAGE_API = '/api/coverage';
	// Greater Mendoza, from Las Heras to Luján: the map opens here, with no zones drawn.
	const GREATER_MENDOZA: [[number, number], [number, number]] = [
		[-68.98, -33.1],
		[-68.68, -32.8],
	];

	const EMPTY: CoverageZones = { type: 'FeatureCollection', features: [] };

	type CoverageLookup = { technologies: string[]; radius: number; zones: CoverageZones };
	class RateLimitedError extends Error {}

	let ready: Promise<{ map: MapLibreMap; maplibre: typeof import('maplibre-gl') }> | undefined;

	const checker = section?.querySelector<HTMLElement>('[data-coverage-checker]');

	/**
	 * Room the map must leave free so zones and the pin aren't hidden behind the floating
	 * checker (left) and legend (bottom). On phones both sit outside the map, so no room is needed.
	 */
	const mapPadding = () => {
		const floating = checker && getComputedStyle(checker).position === 'absolute';
		return floating
			? { top: 40, right: 60, bottom: 110, left: checker.offsetWidth + 60 }
			: { top: 40, right: 40, bottom: 40, left: 40 };
	};

	/** Loads MapLibre once, whether triggered by scrolling or by a search. Starts with no zones. */
	function loadMap(el: HTMLElement) {
		ready ??= (async () => {
			// MapLibre, its worker and its CSS are all split out and fetched together.
			const [maplibre, { default: workerUrl }] = await Promise.all([
				import('maplibre-gl'),
				import('maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url'),
				import('maplibre-gl/dist/maplibre-gl.css'),
			]);
			const { Map, NavigationControl, setWorkerUrl } = maplibre;
			setWorkerUrl(workerUrl);

			status?.remove();
			el.classList.add('is-ready');

			const map = new Map({
				container: el,
				style: STYLE,
				bounds: GREATER_MENDOZA,
				fitBoundsOptions: { padding: mapPadding() },
				// Page scroll keeps working; zooming needs ctrl/⌘ or two fingers.
				cooperativeGestures: true,
				dragRotate: false,
				pitchWithRotate: false,
				attributionControl: { compact: true },
				locale: {
					'CooperativeGesturesHandler.WindowsHelpText': 'Usá Ctrl + scroll para hacer zoom',
					'CooperativeGesturesHandler.MacHelpText': 'Usá ⌘ + scroll para hacer zoom',
					'CooperativeGesturesHandler.MobileHelpText': 'Usá dos dedos para mover el mapa',
					'NavigationControl.ZoomIn': 'Acercar',
					'NavigationControl.ZoomOut': 'Alejar',
				},
			});
			map.addControl(new NavigationControl({ showCompass: false }), 'top-right');

			await new Promise<void>((resolve) => map.once('load', () => resolve()));
			// Both sources start empty and are filled by each search's lookup.
			map.addSource('coverage', { type: 'geojson', data: EMPTY });
			map.addSource('radius', { type: 'geojson', data: EMPTY });
			for (const [technology, color] of Object.entries(COLORS)) {
				const filter = ['==', ['get', 'technology'], technology] as ['==', ['get', string], string];
				map.addLayer({
					id: `coverage-${technology}-fill`,
					type: 'fill',
					source: 'coverage',
					filter,
					paint: { 'fill-color': color, 'fill-opacity': 0.25 },
				});
				map.addLayer({
					id: `coverage-${technology}-outline`,
					type: 'line',
					source: 'coverage',
					filter,
					paint: { 'line-color': color, 'line-width': 1.5, 'line-opacity': 0.9 },
				});
			}
			// Drawn last: the ring also covers the seams clipping leaves along the circle's edge.
			map.addLayer({
				id: 'radius-outline',
				type: 'line',
				source: 'radius',
				paint: { 'line-color': RADIUS_COLOR, 'line-width': 1.5, 'line-opacity': 0.6, 'line-dasharray': [2, 2] },
			});
			return { map, maplibre };
		})();
		return ready;
	}

	/** Swaps what the map shows around the address; no zones and no ring clear it. */
	function setZones(map: MapLibreMap, zones: CoverageZones, ring: Position[] | null) {
		map.getSource<GeoJSONSource>('coverage')?.setData(zones);
		map.getSource<GeoJSONSource>('radius')?.setData(
			ring ? { type: 'Feature', properties: {}, geometry: { type: 'Polygon', coordinates: [ring] } } : EMPTY,
		);
	}

	/** Asks the server which technologies reach the point and for the zones around it. */
	async function lookupCoverage([lng, lat]: Position): Promise<CoverageLookup> {
		const url = new URL(COVERAGE_API, location.origin);
		url.search = new URLSearchParams({ lat: String(lat), lng: String(lng) }).toString();
		const response = await fetch(url, { signal: AbortSignal.timeout(8000) });
		if (response.status === 429) throw new RateLimitedError();
		if (!response.ok) throw new Error(`Coverage API ${response.status}`);
		return response.json();
	}

	if (section && container) {
		const form = section.querySelector<HTMLFormElement>('[data-coverage-search]')!;
		const input = form.querySelector<HTMLInputElement>('input')!;
		const submit = form.querySelector<HTMLButtonElement>('button')!;
		const note = section.querySelector<HTMLElement>('[data-coverage-note]')!;
		const matches = section.querySelector<HTMLElement>('[data-coverage-matches]')!;
		const matchesList = matches.querySelector('ul')!;
		const result = section.querySelector<HTMLElement>('[data-coverage-result]')!;
		const resultTitle = result.querySelector<HTMLElement>('[data-result-title]')!;
		const resultPlace = result.querySelector<HTMLElement>('[data-result-place]')!;
		const resultCta = result.querySelector<HTMLAnchorElement>('[data-result-cta]')!;
		const resultCtaLabel = result.querySelector<HTMLElement>('[data-result-cta-label]')!;
		let marker: Marker | undefined;
		// Lets a slow lookup know a newer search replaced it, so it doesn't draw over it.
		let searches = 0;

		/** Only one of note / matches / result is visible at a time. */
		const show = (panel: HTMLElement) => {
			for (const element of [note, matches, result]) element.hidden = element !== panel;
		};

		const showNote = (text: string) => {
			note.textContent = text;
			show(note);
		};

		const setLoading = (loading: boolean) => {
			submit.disabled = loading;
			submit.classList.toggle('is-loading', loading);
		};

		/** Drops a pin on the point, shows the coverage around it and says which service reaches it. */
		async function check(position: Position, place: string) {
			const search = ++searches;
			// The previous result goes away right away, even if this lookup ends up failing.
			marker?.remove();
			ready?.then(({ map }) => setZones(map, EMPTY, null)).catch(() => {});

			let lookup: CoverageLookup;
			let map: MapLibreMap;
			let maplibre: typeof import('maplibre-gl');
			try {
				[{ map, maplibre }, lookup] = await Promise.all([loadMap(container!), lookupCoverage(position)]);
			} catch (error) {
				if (search !== searches) return;
				console.error('[coverage] Could not check the address:', error instanceof Error ? error.name : error);
				showNote(
					error instanceof RateLimitedError
						? 'Hiciste muchas búsquedas seguidas. Probá de nuevo en unos minutos.'
						: 'No pudimos verificar la dirección en este momento. Probá de nuevo en unos minutos.',
				);
				return;
			}
			if (search !== searches) return;

			const ring = circle(position, lookup.radius);
			setZones(map, lookup.zones, ring);

			const pin = document.createElement('div');
			pin.className = 'coverage-pin';
			marker = new maplibre.Marker({ element: pin }).setLngLat(position).addTo(map);
			const [minLng, minLat, maxLng, maxLat] = bboxOf(ring);
			map.fitBounds(
				[
					[minLng, minLat],
					[maxLng, maxLat],
				],
				{ padding: mapPadding(), essential: false },
			);

			const found = lookup.technologies;
			const [tone, title, cta] = found.includes('fibra')
				? ['fibra', '¡Hay fibra óptica en tu zona!', { href: '#planesfo', label: 'Ver planes' }]
				: found.includes('wireless')
					? ['wireless', 'Llegamos con Internet wireless', { href: '#planesfo', label: 'Ver planes' }]
					: ['none', 'Todavía no llegamos a esa zona', { href: '#contactanos', label: 'Avisame cuando lleguen' }];

			result.dataset.tone = tone;
			resultTitle.textContent = title;
			resultPlace.textContent = place;
			resultCta.href = cta.href;
			resultCtaLabel.textContent = cta.label;
			show(result);
		}

		function showMatches(options: AddressMatch[]) {
			matchesList.replaceChildren(
				...options.map((option) => {
					const item = document.createElement('li');
					const button = document.createElement('button');
					button.type = 'button';
					button.textContent = option.label;
					button.addEventListener('click', () => check(option.position, option.label));
					item.append(button);
					return item;
				}),
			);
			show(matches);
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const { street, hint } = parseAddress(input.value);
			if (!street) return;

			setLoading(true);
			showNote('Buscando…');
			loadMap(container); // start loading the map in parallel with the lookup

			try {
				const url = new URL(GEOREF);
				url.search = new URLSearchParams({
					direccion: street,
					provincia: 'mendoza',
					max: '10',
					campos: 'nomenclatura,ubicacion,departamento.nombre,localidad_censal.nombre',
				}).toString();
				const response = await fetch(url, { signal: AbortSignal.timeout(8000) });
				if (!response.ok) throw new Error(`Georef ${response.status}`);
				const found = toMatches((await response.json()).direcciones ?? [], hint);

				if (found.length === 0) {
					showNote('No encontramos esa dirección. Probá con calle y número, por ejemplo "Belgrano 1500, Capital".');
				} else if (found.length === 1) {
					await check(found[0].position, found[0].label);
				} else {
					showMatches(found);
				}
			} catch (error) {
				console.error('[coverage] Address search failed:', error);
				showNote('No pudimos buscar la dirección en este momento. Probá de nuevo en unos minutos.');
			} finally {
				setLoading(false);
			}
		});

		// MapLibre is heavy: only fetch it when the section is about to be seen.
		const observer = new IntersectionObserver(
			([entry]) => {
				if (!entry.isIntersecting) return;
				observer.disconnect();
				loadMap(container).catch((error) => {
					console.error('[coverage] Could not load the map:', error);
					if (status) status.textContent = 'No pudimos cargar el mapa. Probá de nuevo más tarde.';
				});
			},
			{ rootMargin: '300px 0px' },
		);
		observer.observe(container);
	}
</script>

<style>
	.heading {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		align-items: end;
		gap: 1.5rem;
	}

	.heading > div {
		grid-column: span 7;
	}

	.heading h2 {
		margin-top: 1rem;
	}

	.heading .lead {
		grid-column: 9 / span 4;
	}

	.map-panel {
		position: relative;
		margin-top: 3rem;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius-panel);
		background: var(--paper);
	}

	/* Checker: the search pill floats on its own over the map; feedback gets a card below it. */
	.checker {
		position: absolute;
		top: 1.25rem;
		left: 1.25rem;
		z-index: 2;
		display: flex;
		flex-direction: column;
		width: min(24rem, calc(100% - 2.5rem));
		/* Leaves room for the legend at the bottom; long match lists scroll inside the feedback. */
		max-height: calc(100% - 7.5rem);
	}

	.checker [hidden] {
		display: none;
	}

	/* Search pill with the round arrow button inside, echoing the site's CTAs. */
	.search {
		position: relative;
	}

	.search input {
		width: 100%;
		padding: 0.9rem 3.5rem 0.9rem 1.25rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		font: 400 0.9375rem var(--font-body);
		color: var(--ink);
		background: var(--cream);
		box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.35);
		transition:
			border-color 0.2s,
			background-color 0.2s;
	}

	.search input::placeholder {
		color: var(--muted);
	}

	.search input:focus {
		outline: none;
		border-color: var(--purple);
		background: var(--paper);
	}

	.search-submit {
		position: absolute;
		top: 50%;
		right: 0.35rem;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		border-radius: 50%;
		background: var(--ink);
		color: var(--cream);
		cursor: pointer;
		transform: translateY(-50%);
		transition: background-color 0.3s;
	}

	.search-submit :global(svg) {
		transition: transform 0.3s var(--ease-out);
	}

	.search-submit:hover {
		background: var(--purple);
	}

	.search-submit:hover :global(svg) {
		transform: rotate(-45deg);
	}

	/* While searching the arrow turns into a spinner. */
	.search-submit.is-loading {
		cursor: progress;
	}

	.search-submit.is-loading :global(svg) {
		display: none;
	}

	.search-submit.is-loading::after {
		content: '';
		width: 1rem;
		height: 1rem;
		border: 2px solid color-mix(in srgb, var(--cream) 35%, transparent);
		border-top-color: var(--cream);
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* Stays empty (and invisible) until there's something to say, so the live region is always present. */
	.feedback {
		min-height: 0;
		overflow-y: auto;
		border-radius: var(--radius-card);
	}

	.feedback:has(> :not([hidden])) {
		margin-top: 0.75rem;
		padding: 1.25rem;
		background: color-mix(in srgb, var(--paper) 95%, transparent);
		box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.35);
		backdrop-filter: blur(8px);
	}

	.note {
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--muted);
	}

	/* Matches: divided rows like the FAQ list. */
	.matches-title {
		margin-bottom: 0.5rem;
		font-size: 0.8125rem;
		color: var(--muted);
	}

	.matches ul {
		border-bottom: 1px solid var(--line);
	}

	.matches li {
		border-top: 1px solid var(--line);
	}

	.matches :global(button) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		padding: 0.75rem 0;
		border: 0;
		background: none;
		font: 400 0.875rem / 1.4 var(--font-body);
		color: var(--ink);
		text-align: left;
		cursor: pointer;
		transition: color 0.2s;
	}

	.matches :global(button)::after {
		content: '→';
		color: var(--muted);
		transition:
			color 0.2s,
			transform 0.3s var(--ease-out);
	}

	.matches :global(button:hover),
	.matches :global(button:hover)::after {
		color: var(--purple);
	}

	.matches :global(button:hover)::after {
		transform: translateX(3px);
	}

	/* Result: tinted with the technology's map color. */
	.result {
		--tone: var(--muted);
		display: grid;
		gap: 0.35rem;
		padding: 1.1rem 1.25rem 1.25rem;
		border: 1px solid color-mix(in srgb, var(--tone) 25%, transparent);
		border-radius: 1.1rem;
		background: color-mix(in srgb, var(--tone) 10%, var(--paper));
	}

	.result[data-tone='fibra'] {
		--tone: var(--purple);
	}

	.result[data-tone='wireless'] {
		--tone: var(--gold);
	}

	.result-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.025em;
	}

	.result-dot {
		flex-shrink: 0;
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		background: var(--tone);
	}

	.result-place {
		padding-left: 1.25rem;
		font-size: 0.8125rem;
		color: var(--muted);
	}

	.result .btn {
		justify-self: start;
		margin-top: 0.75rem;
	}

	.map {
		display: grid;
		place-items: center;
		height: clamp(480px, 72svh, 680px);
	}

	/* MapLibre positions its own canvas and controls. */
	.map.is-ready {
		display: block;
	}

	.status {
		font-size: 0.875rem;
		color: var(--muted);
	}

	/* The pin is created by JS inside MapLibre's DOM, outside this component's scope. */
	.map :global(.coverage-pin) {
		width: 1.25rem;
		height: 1.25rem;
		border: 3px solid #fff;
		border-radius: 50%;
		background: var(--ink);
		box-shadow:
			0 0 0 6px color-mix(in srgb, var(--ink) 20%, transparent),
			0 4px 12px rgba(0, 0, 0, 0.35);
	}

	/* Floats over the map like the hero's plan card. */
	.legend {
		position: absolute;
		left: 1.25rem;
		bottom: 1.25rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		max-width: calc(100% - 2.5rem);
		padding: 0.75rem 0.75rem 0.75rem 1.25rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--paper) 95%, transparent);
		box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.35);
		backdrop-filter: blur(8px);
	}

	.legend ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
	}

	.legend li {
		display: flex;
		align-items: center;
