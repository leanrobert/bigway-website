# Google Business Profile API (live reviews). Server-only secrets, never commit real values.
# OAuth client of type "Web application"; the refresh token must belong to an owner/manager
# of the Business Profile, with scope https://www.googleapis.com/auth/business.manage.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
# accounts/{accountId}/locations/{locationId} — run `pnpm gbp:locations` to find it.
GBP_LOCATION=

# Reverse proxies (comma-separated) allowed to tell the coverage API the visitor's IP through
# X-Forwarded-For, besides loopback (127.0.0.1 / ::1). Only needed when nginx connects to Node
# from another address. Without it, all visitors share one coverage lookup rate limit.
COVERAGE_TRUSTED_PROXIES=
